

CREATE COMPUTE MODULE Conditional_Statements_mf_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
         CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		DECLARE inRef REFERENCE TO InputRoot.XMLNSC.student;

-- Properly create JSON structure
CREATE FIELD OutputRoot.JSON.Data.result;
DECLARE outRef REFERENCE TO OutputRoot.JSON.Data.result;

-- Conditional Logic: Check Age
IF (inRef.age < 18) THEN 
    SET outRef.status = 'Minor';
ELSEIF inRef > 18 AND inRef < 60 THEN
    SET outRef.age.status = 'Major';
ELSE
    SET outRef.age.status = 'Senior';
END IF;
  --CASE STATEMENT  
--SET outRef = 
            --CASE 
                --WHEN inRef.age < 18 THEN 'Minor'
                --WHEN inRef.age = 18 THEN 'Adult'
               -- WHEN inRef.age > 18 AND inRef.age < 60 THEN 'Major'
               -- ELSE 'Senior'
            --END;

        RETURN TRUE;
    END;
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
