

CREATE COMPUTE MODULE Logical_Operators_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		 CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		DECLARE inRef REFERENCE TO InputRoot.XMLNSC.OrderDetails;
		CREATE FIELD OutputRoot.JSON.Data.status;
		DECLARE outRef REFERENCE TO OutputRoot.JSON.Data.status;
		
	--IF inRef.Brand LIKE '%Nike%' AND inRef.MadeIn = 'India' THEN (Like operator)
	--IF inRef.Brand LIKE '%Nike%' OR inRef.Amount>3000 THEN (OR operator)
	IF inRef.Payment IS NOT FALSE THEN 
            SET outRef.status = 'Your order has been successfully generated';
       ELSE 
             SET outRef.status = 'Something went wrong. Please try again';
      END IF;
      RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
