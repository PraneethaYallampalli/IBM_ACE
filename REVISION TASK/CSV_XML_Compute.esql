

CREATE COMPUTE MODULE CSV_XML_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		 CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		DECLARE csvRef REFERENCE TO InputRoot.DFDL.Student_Details.record;
		CREATE LASTCHILD OF OutputRoot.XMLNSC NAME 'Student_Details';
		DECLARE outRef REFERENCE TO OutputRoot.XMLNSC.Student_Details;
		
		WHILE LASTMOVE(csvRef) DO
			CREATE LASTCHILD OF outRef Name 'Student';
			 MOVE outRef LASTCHILD;
			 
			 
			 CREATE LASTCHILD OF outRef NAME 'StudentId' VALUE csvRef.StudentId;
			 CREATE LASTCHILD OF outRef NAME 'Name' VALUE csvRef.Name;
			 CREATE LASTCHILD OF outRef NAME 'Age' VALUE csvRef.Age;
			 CREATE LASTCHILD OF outRef NAME 'City' VALUE csvRef.City;
			 CREATE LASTCHILD OF outRef NAME 'Grade' VALUE csvRef.Grade;
			 CREATE LASTCHILD OF outRef NAME 'Department' VALUE csvRef.Department;
			 
			 MOVE csvRef NEXTSIBLING;
			 
	  END WHILE;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
