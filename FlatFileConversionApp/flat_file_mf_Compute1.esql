

CREATE COMPUTE MODULE flat_file_mf_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		 CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		  CREATE LASTCHILD OF OutputRoot DOMAIN('XMLNSC') NAME 'Employee';

        -- Reference all child fields dynamically
        DECLARE fld REFERENCE TO InputRoot.DFDL.flatfile.*;
        DECLARE outFld REFERENCE TO OutputRoot.XMLNSC.flatfile;

        -- Loop through each field and create corresponding XML element
        WHILE fld IS NOT NULL DO
            CREATE LASTCHILD OF outFld 
                NAME FIELDNAME(fld) 
                VALUE fld;
            MOVE fld NEXTSIBLING;
        END WHILE;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
