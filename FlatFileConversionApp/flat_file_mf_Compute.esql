

CREATE COMPUTE MODULE flat_file_mf_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		 CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		DECLARE age INT FIELDVALUE(InputRoot.DFDL.Employee.Age);
        DECLARE email CHAR FIELDVALUE(InputRoot.DFDL.Employee.Email);
        
        -- Check for invalid data
        IF age < 18 OR POSITION('@' IN email) = 0 THEN
            -- Send to Failure terminal if invalid
            PROPAGATE TO TERMINAL 'FAILURE';
        ELSE
            -- Forward to Success terminal (default)
            PROPAGATE;
        END IF;
        
        -- Return value (not used for routing)
        RETURN FALSE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
