

CREATE COMPUTE MODULE getGetbank_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		 CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		DECLARE id CHARACTER InputLocalEnvironment.REST.Input.Parameters.id;
		DECLARE bankName CHARACTER;
		DECLARE message CHARACTER;
		SET Environment.ibm_ace.bank_detailss[] = SELECT t.bankName FROM Database.ibm_ace.bank_detailss AS t WHERE t.id = id;
		
	
	
		IF Environment.ibm_ace.bank_detailss.bankName = 'Union' THEN 
			 SET message = 'Bank details created successfully';
		ELSEIF Environment.ibm_ace.bank_detailss.bankName = 'Not Union' THEN 
			 SET message = 'Bank details not processed';
		END IF;
		
		SET OutputRoot.JSON.Data.id = id;
		SET OutputRoot.JSON.Data.bankName = Environment.ibm_ace.bank_detailss.bankName;
	   SET OutputRoot.JSON.Data.message = message;
		
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
