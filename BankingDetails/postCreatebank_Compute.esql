

CREATE COMPUTE MODULE postCreatebank_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		 CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		DECLARE authHeader CHARACTER;
		DECLARE expectedAuthHeader CHARACTER 'Basic cHJhbmVldGhhOjEyMzQ='; 
        SET authHeader = InputRoot.HTTPInputHeader.Authorization;
        
        IF authHeader = expectedAuthHeader THEN
        	 SET OutputRoot = InputRoot;
        ELSE
        	SET OutputRoot.JSON.Data.Result = 'Unauthorised';
        	RETURN TRUE;
        END IF;
        
		DECLARE uniqId CHARACTER UUIDASCHAR;
		DECLARE inref REFERENCE TO InputRoot.JSON.Data;
		DECLARE message CHARACTER;
		
		IF inref.bankName = 'Union' THEN 
			 SET message = 'Bank details created successfully';
		ELSEIF inref.bankName = 'Not Union' THEN 
			 SET message = 'Bank details not processed';
		END IF;
			
		INSERT INTO Database.ibm_ace.bank_detailss Values(uniqId ,inref.accountHolderName,inref.accountNumber,inref.bankName,inref.branchName,inref.ifscCode,inref.routingNumber);
		 
		SET OutputRoot.JSON.Data.message = message;
		SET OutputRoot.JSON.Data.id = uniqId;
		
		RETURN TRUE;
		
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
